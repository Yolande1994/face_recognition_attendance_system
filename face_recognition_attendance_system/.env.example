# 服务启动配置
HOST=0.0.0.0
PORT=8000

# 人脸识别阈值配置
MODEL_ROOT=./models
VERIFY_THRESHOLD=0.65
RECOGNITION_THRESHOLD=0.7

# 数据库（二选一，默认sqlite免安装）
DB_TYPE=sqlite
SQLITE_PATH=./face_recognition.db

# MySQL配置（切换DB_TYPE=mysql时启用）
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=你的数据库密码
# MYSQL_DB=face_recognition_db

# 管理员接口鉴权Token（请求头X-Admin-Token）
ADMIN_TOKEN=admin123456
